{% comment %}Include only on the existing order-detail page. No shop API token is used.{% endcomment %}
{% assign address_order_number = order.order_info.order_no | default: order.id %}
<section class="maildesk-customer-address" style="max-width:1364px;margin:32px auto;border:1px solid #e5e5e5;padding:20px;">
  <details>
    <summary style="cursor:pointer;font-size:20px;padding:8px 0;">Update shipping address</summary>
    <iframe title="Update shipping address" loading="lazy"
      src="https://chat.thinkpro.top/maildesk/customer-address/#store={{ shop.id }}"
      data-store="{{ shop.id }}" data-order="{{ address_order_number | escape }}" data-email="{{ order.customer.email | escape }}"
      style="display:block;width:100%;height:1000px;border:0;" referrerpolicy="no-referrer"></iframe>
  </details>
</section>
<script>
(function () {
  var frame = document.currentScript.previousElementSibling.querySelector('iframe');
  var origin = new URL(frame.src).origin;
  window.addEventListener('message', function (event) {
    if (event.origin !== origin || event.source !== frame.contentWindow || !event.data || event.data.type !== 'maildesk-address-ready') return;
    frame.contentWindow.postMessage({type:'maildesk-address-order',store:frame.dataset.store,order:frame.dataset.order,email:frame.dataset.email}, origin);
  });
})();
</script>
