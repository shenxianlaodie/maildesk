# Read-only order source. Never use this database for mail storage.
ORDER_DATABASE_URL=postgresql://order_reader:REPLACE_ME@DB_HOST:5432/support_portal?sslmode=require
# Business mail, drafts, attachments, credentials and backups stay on local disk.
# Set an absolute persistent directory when deploying, e.g. /var/lib/maildesk.
# Demo data always remains separate.
# MAILDESK_DATA_DIR=/var/lib/maildesk

# Required by scripts/start-server.cjs (HTTPS gateway behind Nginx).
# MAILDESK_PUBLIC_ORIGIN=https://chat.thinkpro.top
